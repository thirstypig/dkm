---
import { site } from '../data/site';

interface Props {
  /* Defaults to site.formspreeId; overridable so tests can render both states. */
  formspreeId?: string;
}
const { formspreeId = site.formspreeId } = Astro.props;
const connected = formspreeId.trim() !== '';
const action = connected ? `https://formspree.io/f/${formspreeId.trim()}` : undefined;
---
<form
  class="form"
  id="inquiry-form"
  action={action}
  method="POST"
>
  <!-- Honeypot. The name MUST be `_gotcha` (Formspree drops on it). The label
       must not name a field any autofill profile knows: "Company" here got
       filled by Chrome address autofill on pasadenaworks and real inquiries
       were silently discarded. -->
  <div class="hp" aria-hidden="true">
    <label for="_gotcha">Leave this field empty</label>
    <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="_subject" value="New DKM inquiry" />

  <div class="form-row">
    <div class="field">
      <label for="f-name">Name</label>
      <input type="text" id="f-name" name="name" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="f-email">Email</label>
      <input type="email" id="f-email" name="email" required autocomplete="email" />
    </div>
  </div>
  <div class="field">
    <!-- `organization`, not `company`: the latter is an address-autofill name. -->
    <label for="f-org">Company / show</label>
    <input type="text" id="f-org" name="organization" autocomplete="organization" />
  </div>
  <div class="field">
    <label for="f-service">I’m interested in</label>
    <select id="f-service" name="service">
      <option>Talent Producing (ongoing series)</option>
      <option>Talent Booking (single project)</option>
      <option>Not sure yet</option>
    </select>
  </div>
  <div class="field">
    <label for="f-message">Tell her about it</label>
    <textarea id="f-message" name="message" rows="6" required></textarea>
  </div>

  {!connected && (
    <p class="form-note">The inquiry form isn’t connected yet. Please reach out on Instagram or LinkedIn in the meantime.</p>
  )}
  <div>
    <button type="submit" class="btn btn-primary" disabled={!connected}>Send inquiry</button>
  </div>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<script>
  import { initInquiryForm } from '../scripts/inquiry-form';
  const form = document.getElementById('inquiry-form');
  // No action attribute = not connected yet; leave the disabled form alone.
  if (form instanceof HTMLFormElement && form.getAttribute('action')?.startsWith('https://formspree.io/f/')) {
    initInquiryForm(form);
  }
</script>
