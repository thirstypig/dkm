---
import { site } from '../data/site';

interface Props {
  /* Defaults to site.formspreeId; overridable so tests can render both states. */
  formspreeId?: string;
}
const { formspreeId = site.formspreeId } = Astro.props;
const connected = formspreeId.trim() !== '';
const action = connected ? `https://formspree.io/f/${formspreeId.trim()}` : undefined;
---
<form
  class="form"
  id="inquiry-form"
  action={action}
  method="POST"
  data-msg-sending="Sending…"
  data-msg-success="Thank you — your inquiry is on its way. Donyell will reply personally."
  data-msg-error="Something went wrong. Please try again in a moment."
>
  <!-- Honeypot. The name MUST be `_gotcha` (Formspree drops on it). The label
       must not name a field any autofill profile knows: "Company" here got
       filled by Chrome address autofill on pasadenaworks and real inquiries
       were silently discarded. -->
  <div class="hp" aria-hidden="true">
    <label for="_gotcha">Leave this field empty</label>
    <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="_subject" value="New DKM inquiry" />

  <div class="form-row">
    <div class="field">
      <label for="f-name">Name</label>
      <input type="text" id="f-name" name="name" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="f-email">Email</label>
      <input type="email" id="f-email" name="email" required autocomplete="email" />
    </div>
  </div>
  <div class="field">
    <!-- `organization`, not `company`: the latter is an address-autofill name. -->
    <label for="f-org">Company / show</label>
    <input type="text" id="f-org" name="organization" autocomplete="organization" />
  </div>
  <div class="field">
    <label for="f-service">I’m interested in</label>
    <select id="f-service" name="service">
      <option>Talent Producing (ongoing series)</option>
      <option>Talent Booking (single project)</option>
      <option>Not sure yet</option>
    </select>
  </div>
  <div class="field">
    <label for="f-message">Tell her about it</label>
    <textarea id="f-message" name="message" rows="6" required></textarea>
  </div>

  {!connected && (
    <p class="form-note">The inquiry form isn’t connected yet. Please reach out on Instagram or LinkedIn in the meantime.</p>
  )}
  <div>
    <button type="submit" class="btn btn-primary" disabled={!connected}>Send inquiry</button>
  </div>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('inquiry-form');
  if (form instanceof HTMLFormElement && form.action.startsWith('https://formspree.io/f/')) {
    const button = form.querySelector('button[type="submit"]');
    const status = form.querySelector('.form-status');
    const msgSending = form.dataset.msgSending ?? '';
    const msgSuccess = form.dataset.msgSuccess ?? '';
    const msgError = form.dataset.msgError ?? '';
    if (button instanceof HTMLButtonElement && status instanceof HTMLElement) {
      const label = button.textContent ?? '';
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        status.classList.remove('form-status--error');

        // Honeypot filled => a bot. Report success and send nothing.
        if (String(data.get('_gotcha') ?? '').trim() !== '') {
          form.reset();
          status.textContent = msgSuccess;
          return;
        }

        button.disabled = true;
        button.textContent = msgSending;
        status.textContent = '';
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });
          if (response.ok) {
            form.reset();
            status.textContent = msgSuccess;
          } else {
            status.textContent = msgError;
            status.classList.add('form-status--error');
          }
        } catch {
          status.textContent = msgError;
          status.classList.add('form-status--error');
        } finally {
          button.disabled = false;
          button.textContent = label;
        }
      });
    }
  }
</script>
