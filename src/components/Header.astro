---
import { site, type NavKey } from '../data/site';

interface Props {
  current?: NavKey;
}
const { current } = Astro.props;
---
<header class="hdr">
  <a class="logo" href="/">DKM</a>
  <button class="burger" type="button" aria-controls="site-nav" aria-expanded="false">Menu</button>
  <nav class="nav" id="site-nav" aria-label="Main">
    {site.nav.map((item) => (
      <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>{item.label}</a>
    ))}
    <a class="ig" href={site.socials[0].href} target="_blank" rel="me noopener" aria-label="Instagram">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
    </a>
  </nav>
</header>
<hr class="rule" />

<script>
  // Mobile disclosure menu. On desktop the nav is always visible (CSS), so the
  // button is hidden and this only matters ≤820px.
  const button = document.querySelector<HTMLButtonElement>('.burger');
  const nav = document.getElementById('site-nav');
  if (button && nav) {
    const set = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Close' : 'Menu';
      nav.classList.toggle('nav--open', open);
    };
    button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        set(false);
        button.focus();
      }
    });
  }
</script>
