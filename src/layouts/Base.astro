---
import '@fontsource/bebas-neue/400.css';
import '@fontsource/archivo/300.css';
import '@fontsource/archivo/500.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { NavKey } from '../data/site';

interface Props {
  title: string;
  description: string;
  current?: NavKey;
}
const { title, description, current } = Astro.props;
const fullTitle = current === 'home' ? title : `${title} · DKM`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Hidden from search engines until Donyell approves the site.
         Launch = remove this, public/robots.txt's Disallow, and update tests. -->
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content={description}>
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FAF8F3" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
